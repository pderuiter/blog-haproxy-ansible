global
    log /dev/log local0
    log /dev/log local1 notice
    stats socket {{ dataplaneapi_haproxy_socket }} mode 660 level admin
    user {{ dataplaneapi_haproxy_user }}
    group {{ dataplaneapi_haproxy_group }}

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5000ms
    timeout client  50000ms
    timeout server  50000ms

userlist dataplaneapi
    user {{ dataplaneapi_user }} password {{ dataplaneapi_password_hash }}

frontend http-in
    bind *:80
    default_backend servers

backend servers
    server server1 127.0.0.1:8000 maxconn 32
